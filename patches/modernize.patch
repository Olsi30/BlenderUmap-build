+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json;
+using Microsoft.Extensions.Logging;
+using Unreal.Core;
+using Unreal.Core.Extensions;
+using Unreal.Core.Models;
+using Unreal.Core.Models.Enums;
+
+namespace BlenderUmap.Extensions;
+
+// Retain full package paths; the statistics reader otherwise keeps only short names.
+public sealed class ModernReplayReader : FortniteReplayReader.ReplayReader
+{
+    private readonly Dictionary<uint, (uint Outer, string Name)> paths = new();
+    public readonly Dictionary<uint, ReplayActor> Actors = new();
+    public readonly ReplayDiagnostics Diagnostics;
+
+    public ModernReplayReader() : this(new ReplayDiagnostics()) { }
+    private ModernReplayReader(ReplayDiagnostics diagnostics) : base(diagnostics, ParseMode.Minimal)
+    {
+        Diagnostics = diagnostics;
+    }
+
+    public override NetworkGUID InternalLoadObject(FArchive archive, bool exporting, int depth = 0)
+    {
+        if (depth > 16) throw new InvalidDataException("Replay object path recursion exceeded 16.");
+        var guid = new NetworkGUID { Value = archive.ReadIntPacked() };
+        if (!guid.IsValid()) return guid;
+        if (guid.IsDefault() || exporting)
+        {
+            var flags = archive.ReadByteAsEnum<ExportFlags>();
+            if (flags.HasFlag(ExportFlags.bHasPath))
+            {
+                var outer = InternalLoadObject(archive, true, depth + 1);
+                var name = archive.ReadFString();
+                if (flags.HasFlag(ExportFlags.bHasNetworkChecksum)) archive.ReadUInt32();
+                paths[guid.Value] = (outer.Value, name);
+                if (exporting) _netGuidCache.NetGuidToPathName[guid.Value] = name.RemoveAllPathPrefixes();
+            }
+        }
+        return guid;
+    }
+
+    private string Resolve(uint id, int depth = 0)
+    {
+        if (depth > 16 || !paths.TryGetValue(id, out var entry)) return null;
+        if (entry.Name.StartsWith("/")) return entry.Name;
+        var parent = Resolve(entry.Outer, depth + 1);
+        return parent is null ? null : parent + "." + entry.Name;
+    }
+
+    protected override void OnChannelOpened(uint index, NetworkGUID guid)
+    {
+        var actor = Channels[index]?.Actor;
+        if (actor != null)
+            Actors[actor.ActorNetGUID.Value] = new ReplayActor(this, actor);
+        base.OnChannelOpened(index, guid);
+    }
+
+    // Keep every observed actor even when its replication channel closes.
+    public sealed class ReplayActor(ModernReplayReader reader, Actor actor)
+    {
+        public uint Id => actor.ActorNetGUID.Value;
+        public string Level => reader.Resolve(actor.Level?.Value ?? 0);
+        public string GetObject()
+        {
+            var path = reader.Resolve(actor.Archetype?.Value ?? 0);
+            if (path is null) return null;
+            return path.Replace(".Default__", ".");
+        }
+        public FVector Location => actor.Location;
+        public FRotator Rotation => actor.Rotation;
+        public FVector Scale => actor.Scale;
+        public bool HasTransform => Location is not null && Rotation is not null && Scale is not null;
+    }
+
+    public object Describe(FortniteReplayReader.Models.FortniteReplay replay) => new
+    {
+        Status = "Replay parsed; complete map export and Fortnite 42.20 compatibility are not established.",
+        FortniteBranch = replay.Header.Branch,
+        EngineVersion = $"{replay.Header.Major}.{replay.Header.Minor}.{replay.Header.Patch}",
+        EngineNetworkVersion = (uint)replay.Header.EngineNetworkVersion,
+        Levels = replay.Header.LevelNamesAndTimes.Select(x => new { Name = x.Item1, Time = x.Item2 }),
+        ObservedActors = Actors.Count,
+        ActorsWithSpawnTransform = Actors.Values.Count(x => x.HasTransform),
+        ActorsWithResolvedArchetype = Actors.Values.Count(x => x.GetObject() != null),
+        WarningCount = Diagnostics.WarningCount,
+        ErrorCount = Diagnostics.ErrorCount,
+        FirstMessages = Diagnostics.FirstMessages,
+        ObjectPaths = Actors.Values.Select(x => x.GetObject()).Where(x => x != null).Distinct().OrderBy(x => x),
+        ActorRecords = Actors.Values
+            .Where(x => x.GetObject() != null)
+            .OrderBy(x => x.GetObject())
+            .ThenBy(x => x.Id)
+            .Select(x => new {
+                Id = x.Id,
+                Level = x.Level,
+                ObjectPath = x.GetObject(),
+                HasTransform = x.HasTransform,
+                Location = x.Location,
+                Rotation = x.Rotation,
+                Scale = x.Scale
+            })
+            .ToArray()
+    };
+
+    public static int Inspect(string input, string output)
+    {
+        var reader = new ModernReplayReader();
+        using var stream = File.OpenRead(input);
+        var replay = reader.ReadReplay(stream);
+        var json = JsonConvert.SerializeObject(reader.Describe(replay), Formatting.Indented);
+        if (output != null) File.WriteAllText(output, json);
+        Console.WriteLine(json);
+        return reader.Diagnostics.ErrorCount == 0 && reader.Actors.Count > 0 ? 0 : 2;
+    }
+}
+
+public sealed class ReplayDiagnostics : ILogger
+{
+    public int WarningCount;
+    public int ErrorCount;
+    public readonly List<string> FirstMessages = new();
+    public IDisposable BeginScope<TState>(TState state) where TState : notnull => null;
+    public bool IsEnabled(LogLevel level) => level >= LogLevel.Warning;
+    public void Log<TState>(LogLevel level, EventId id, TState state, Exception error, Func<TState, Exception, string> formatter)
+    {
+        if (!IsEnabled(level)) return;
+        if (level >= LogLevel.Error) ErrorCount++; else WarningCount++;
+        if (FirstMessages.Count < 8) FirstMessages.Add(formatter(state, error));
+    }
+}
